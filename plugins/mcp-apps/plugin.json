{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "mcp-apps",
  "version": "1.2.0+codex.9d26fde082b4",
  "description": "Generate interactive HTML widgets for MCP tools using the MCP Apps protocol.",
  "author": {
    "name": "LeonardSEO",
    "url": "https://github.com/LeonardSEO"
  },
  "homepage": "https://github.com/LeonardSEO/power-platform-skills-codex",
  "repository": "https://github.com/LeonardSEO/power-platform-skills-codex",
  "license": "MIT",
  "keywords": [
    "mcp-apps",
    "mcp",
    "widgets",
    "html",
    "fluent-ui"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "MCP Apps for Codex",
        "shortDescription": "Build MCP tools and widgets",
        "longDescription": "Codex adaptation of Microsoft's skills for creating self-contained HTML widgets that visualize and interact with MCP tool results.",
        "developerName": "LeonardSEO",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Write"
        ],
        "websiteURL": "https://github.com/LeonardSEO/power-platform-skills-codex",
        "defaultPrompt": "Generate an interactive widget for my MCP tool.",
        "logo": "./assets/codex-power-platform.svg",
        "composerIcon": "./assets/codex-power-platform.svg"
      }
    }
  }
}
